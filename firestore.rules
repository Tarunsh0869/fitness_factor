rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Members ───────────────────────────────────────────────────────────────
    match /members/{memberId} {
      allow read:   if isOwner(memberId);
      allow create: if isOwner(memberId);
      allow update: if isOwner(memberId);
      allow delete: if false;
    }

    // ── Gyms (read-only for authenticated users) ──────────────────────────────
    match /gyms/{gymId} {
      allow read:  if isSignedIn();
      allow write: if false; // managed via Admin SDK / backend only
    }

    // ── Attendance ────────────────────────────────────────────────────────────
    match /attendance/{sessionId} {
      allow read:   if isSignedIn() && resource.data.memberId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.memberId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.memberId == request.auth.uid;
      allow delete: if false;

      match /auditLogs/{logId} {
        allow read:   if isSignedIn() && get(/databases/$(database)/documents/attendance/$(sessionId)).data.memberId == request.auth.uid;
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // ── Feedback ──────────────────────────────────────────────────────────────
    match /feedback/{docId} {
      allow create: if isSignedIn() && request.resource.data.memberId == request.auth.uid;
      allow read:   if isSignedIn() && resource.data.memberId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Exit requests ─────────────────────────────────────────────────────────
    match /exit_requests/{docId} {
      allow create: if isSignedIn() && request.resource.data.memberId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── Attendance deletions (write-only audit trail) ─────────────────────────
    match /attendance_deletions/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
